{
	"name": "my-app",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable baseLocale --silent",
		"prepare": "bun run paraglide:compile && svelte-kit sync",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"test": "bun test",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/playfair-display": "^5.2.8",
		"@inlang/paraglide-js": "^2.19.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^25.7.0",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"publint": "^0.3.18",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@tanstack/table-core": "^8.21.3",
		"@workos-inc/node": "^9.3.0",
		"d3-scale": "^4.0.2",
		"zod": "^4.4.3"
	}
}
